{
  "name": "@butterstudio/pptx",
  "version": "0.1.0-alpha.2",
  "description": "A headless PPTX engine for parsing, selectable rendering, targeted editing, and PowerPoint export in JavaScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butterstudio-in/pptx.git"
  },
  "homepage": "https://github.com/butterstudio-in/pptx#readme",
  "bugs": {
    "url": "https://github.com/butterstudio-in/pptx/issues"
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "presentation",
    "slides",
    "ooxml",
    "headless",
    "renderer",
    "editor"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSES"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "mtx-decompressor": "^1.6.0"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.8.11"
  },
  "engines": {
    "node": ">=20"
  }
}
